{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "functions": {
    "api/index.php": { "runtime": "vercel-php@0.7.4", "maxDuration": 30 }
  },
  "routes": [
    { "src": "/(css|js|fonts|images)/(.*)", "dest": "/public/$1/$2" },
    { "src": "/(favicon\\.ico|robots\\.txt)", "dest": "/public/$1" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ],
  "crons": [{ "path": "/api/cron/expire-orders", "schedule": "0 3 * * *" }]
}
