# Copy to .env.local for local overrides. Everything has a working local default except the
# outside services (RajaOngkir, Brevo, Vercel Blob), which stay off until their keys are set.

# Postgres. Locally leave it empty: an embedded Postgres in .pglite/ is used (npm run db:setup).
# On Vercel the Neon integration sets DATABASE_URL (or POSTGRES_URL) for you.
DATABASE_URL=

# Signs the admin login cookie. Any long random string; required in production.
SESSION_SECRET=

# Where the storefront and this admin live (receipt links in emails, "Lihat di toko").
STOREFRONT_URL=http://localhost:3000
ADMIN_URL=http://localhost:8000

# RajaOngkir (rajaongkir.komerce.id): API key from the RajaOngkir dashboard. The shipping origin is
# picked in the admin (Pengaturan > Asal pengiriman); RAJAONGKIR_ORIGIN is only a fallback id.
RAJAONGKIR_API_KEY=
RAJAONGKIR_COURIERS=jne:jnt:sicepat:pos:tiki:ninja:lion
RAJAONGKIR_ORIGIN=

# Brevo (SMTP & API > API keys). The sender must be verified in Brevo. Without a key, emails are
# saved to .mail/ as HTML files locally instead of being sent.
BREVO_API_KEY=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Masempo Mart"

# Product photos on Vercel Blob (set automatically when a Blob store is connected to the project).
# Without it, uploads go to public/uploads (local dev only).
BLOB_READ_WRITE_TOKEN=

# Vercel Cron sends this to /api/cron/expire-orders. Any long random string.
CRON_SECRET=

# Shop rules
SHOP_HOLD_MINUTES=60
SHOP_LOW_STOCK=5
SHOP_PACKAGING_GRAMS=100
SHOP_FREE_SHIPPING_OVER=0
# Defaults until saved in the admin's Pengaturan page
SHOP_INSTAGRAM_URL=https://www.instagram.com/masempo.mart
SHOP_ORDER_NOTIFY_EMAIL=

# First admin, used by `npm run db:setup` against a hosted database (locally: admin@masempo.test / password)
ADMIN_EMAIL=
ADMIN_PASSWORD=
