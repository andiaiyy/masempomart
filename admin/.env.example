APP_NAME="Masempo Mart"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
# Admin panel times. Asia/Makassar = WITA (Sulawesi); Asia/Jakarta = WIB
APP_TIMEZONE=Asia/Makassar

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local: SQLite file in database/. Production: Postgres (Cloud SQL), e.g.
# DB_CONNECTION=pgsql  DB_HOST=...  DB_PORT=5432  DB_DATABASE=masempo  DB_USERNAME=...  DB_PASSWORD=...
DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="halo@masempo.test"
MAIL_FROM_NAME="${APP_NAME}"

# Proxies whose X-Forwarded-For is trusted (the Next.js storefront). "*" behind Cloud Run.
TRUSTED_PROXIES=127.0.0.1,::1

# First admin account, created by `php artisan db:seed`
ADMIN_EMAIL=admin@masempo.test
ADMIN_PASSWORD=password


# Shop rules (defaults in config/shop.php)
SHOP_HOLD_MINUTES=60
SHOP_LOW_STOCK=5
SHOP_PACKAGING_GRAMS=100
SHOP_FREE_SHIPPING_OVER=0

# RajaOngkir (rajaongkir.komerce.id, API key from the RajaOngkir dashboard). ORIGIN is the destination
# id parcels ship from: php artisan rajaongkir:search "Tanete Riattang"
RAJAONGKIR_API_KEY=
RAJAONGKIR_ORIGIN=
RAJAONGKIR_COURIERS=jne:jnt:sicepat:pos:tiki:ninja:lion

# Product photos. "public" = storage/app/public. In production point an S3-compatible disk at R2:
# SHOP_MEDIA_DISK=s3  AWS_ENDPOINT=https://<account>.r2.cloudflarestorage.com  AWS_URL=https://media.<domain>
SHOP_MEDIA_DISK=public
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
